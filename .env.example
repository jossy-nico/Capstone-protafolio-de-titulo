# Copiar este archivo como .env y reemplazar todos los valores.
# Las credenciales de ejemplo NO sirven para ejecutar integraciones reales.
# No publicar .env ni compartir sus valores.

POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_USER=naturcosecha
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_VOLUME_NAME=natur-cosecha-postgres-data

CLOUDINARY_CLOUD_NAME=REEMPLAZAR
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

WEBPAY_API_KEY=CHANGE_ME
